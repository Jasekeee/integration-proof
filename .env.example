# Copy to .env.local and fill in. Real values never go into git.

# Client ID of the PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=

# Client secret of the same app. Server only.
PAYPAL_CLIENT_SECRET=

# PayPal REST API base URL. Sandbox only: no other host is allowed.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ID of the webhook registered on the sandbox app for https://<host>/api/store/webhooks-router
# (Developer Dashboard > Apps & Credentials > the app > Webhooks). The hardened store sends it to
# verify-webhook-signature.
PAYPAL_WEBHOOK_ID=

# Neon Postgres connection string. Server only. Format:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Neon's dashboard copies it with sslmode=require; change that to verify-full. verify-full checks the
# server certificate and host name, so no host posing as Neon can intercept the connection.
# node-postgres 8 already treats require that way but warns: from its next major, require only
# encrypts. Apply migrations with `npm run db:migrate`.
DATABASE_URL=

# Anthropic API key used by the analyst. Server only.
ANTHROPIC_API_KEY=

# Claude model used by the analyst. Sonnet 5.5 is a deliberate choice for speed and cost;
# the reasoning is in docs/decisions.md.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Port the app listens on. Render sets it; locally it defaults to 3000. The proof runner reaches
# the stores and the fault-injection proxy at http://localhost:$PORT, so set it when the app runs on
# another port.
# PORT=3000

# Same value as PAYPAL_CLIENT_ID. Exposed to the browser for the PayPal JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email of the sandbox personal account people use to pay by hand on /store/naive and
# /store/hardened (Developer Dashboard > Testing Tools > Sandbox Accounts). Shown on that page. Its
# password is never stored here or anywhere in the repository.
SANDBOX_BUYER_EMAIL=

# Secret that turns on live analysis for one run: /proof?fresh=<this value> makes Claude analyse each
# failure again instead of reusing the cache. Any other value is ignored and the run uses the cache.
# Leave empty to turn live analysis off. Server only; generate with `openssl rand -hex 32`.
FRESH_ANALYSIS_TOKEN=

# Ceiling on new Claude analyses in any 24 hours; analyses served from the cache do not count. Past
# it, an analysis reads "unavailable today" and the verdict still shows. Default 30.
ANALYSES_PER_DAY=

# Proof runs one visitor may start in an hour, and all visitors together. The visitor is the address
# Cloudflare reports (CF-Connecting-IP), stored only as a hash. Defaults 6 and 60.
RUNS_PER_VISITOR_PER_HOUR=
RUNS_PER_HOUR=
