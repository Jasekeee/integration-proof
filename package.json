{
  "name": "integration-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Prove your PayPal integration survives a bad day: controlled failures in the PayPal sandbox, deterministic verdicts, and Claude's root cause and verified fix for each failure.",
  "license": "MIT",
  "homepage": "https://integration-proof.onrender.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jasekeee/integration-proof.git"
  },
  "bugs": {
    "url": "https://github.com/Jasekeee/integration-proof/issues"
  },
  "keywords": [
    "paypal",
    "payments",
    "checkout",
    "webhooks",
    "idempotency",
    "fault-injection",
    "testing",
    "nextjs",
    "typescript",
    "claude",
    "anthropic"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx scripts/db-reset.ts",
    "analyst:context": "tsx scripts/analyst-context.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@paypal/react-paypal-js": "10.6.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
